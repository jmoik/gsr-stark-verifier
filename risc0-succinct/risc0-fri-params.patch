+/// The proof-of-work nonce as the digest mixed into the transcript: the nonce in word 0, zeros elsewhere.
+pub(crate) fn pow_digest(nonce: u32) -> core::digest::Digest {
+    let mut words = [0u32; core::digest::DIGEST_WORDS];
+    words[0] = nonce;
+    core::digest::Digest::from(words)
+}
