+/// Re-prove the busy-loop receipt of `gsr_measure` with its final padded proof under the hash suite and FRI
+/// parameters in the JSON object `GSR_FRI_PARAMS` (`{"hashfn": "sha-256-padded-t26", "queries": 18,
+/// "log_inv_rate": 4, ...}`; missing fields take the stock values), verify it natively under those parameters
+/// and not under the stock ones, and write `receipt.json` / `seal.bin` to `R0_GSR_SEAL_DIR`.
+#[test]
+#[ignore]
+fn gsr_fri_params_prove() {
+    use risc0_zkp::fri_params::{self, FriParams};
+
+    let spec: serde_json::Value =
+        serde_json::from_str(&std::env::var("GSR_FRI_PARAMS").unwrap()).unwrap();
+    let stock = fri_params::STOCK;
+    let get = |k: &str, d: usize| spec.get(k).and_then(|v| v.as_u64()).map_or(d, |v| v as usize);
+    let fri = FriParams {
+        queries: get("queries", stock.queries),
+        log_inv_rate: get("log_inv_rate", stock.log_inv_rate),
+        pow_bits: get("pow_bits", stock.pow_bits),
+        cap_log: get("cap_log", stock.cap_log),
+    };
+    let hashfn = spec
+        .get("hashfn")
+        .and_then(|v| v.as_str())
+        .unwrap_or("sha-256-padded");
+
+    let (journal, segments) = BUSY_LOOP_SEGMENTS.clone();
+    let mut compressed = lift(&segments[0]).unwrap();
+    for receipt in &segments[1..] {
+        compressed = join(&compressed, &lift(receipt).unwrap()).unwrap();
+    }
+    let (receipt, params) = super::identity_sha256_padded_with(&compressed, hashfn, fri).unwrap();
+
+    let ctx = VerifierContext::empty()
+        .with_suites(VerifierContext::default_hash_suites())
+        .with_succinct_verifier_parameters(params.clone());
+    {
+        let _fri = fri_params::scoped(fri);
+        receipt.verify_integrity_with_context(&ctx).unwrap();
+    }
+    assert!(fri == stock || receipt.verify_integrity_with_context(&ctx).is_err());
+
+    let dir = std::env::var("R0_GSR_SEAL_DIR").unwrap();
+    std::fs::write(
+        format!("{dir}/seal.bin"),
+        bytemuck::cast_slice::<u32, u8>(&receipt.seal),
+    )
+    .unwrap();
+    std::fs::write(
+        format!("{dir}/receipt.json"),
+        serde_json::to_string_pretty(&gsr_receipt_json(&receipt, &params, &journal.bytes)).unwrap(),
+    )
+    .unwrap();
+    println!("claim : {}", receipt.claim.digest());
+}
