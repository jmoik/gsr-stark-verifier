+
+/// Number of pieces the check (quotient) polynomial is split into. The constraints have degree 5, so the
+/// quotient has degree < 4 * cycles at any blowup; stock RISC Zero ties this to INV_RATE (= 4).
+pub const CHECK_PIECES: usize = 4;
+
+/// GSR research: FRI parameters set per proof, process-wide.
+///
+/// The stock constants above are the defaults. `scoped` changes them for the proof (or verification) run while
+/// the returned guard lives; proofs made under other parameters (segments, lift, join) are unaffected as long as
+/// they do not run concurrently with the guard.
+pub mod fri_params {
+    use core::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+
+    /// The parameters of one proof.
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct FriParams {
+        /// FRI queries.
+        pub queries: usize,
+        /// log2 of the inverse Reed-Solomon rate.
+        pub log_inv_rate: usize,
+        /// Proof-of-work bits ground before the query phase (0: none, as stock).
+        pub pow_bits: usize,
+        /// log2 of the Merkle cap (top layer) of every tree; 0 keeps the stock rule (largest 2^i <= queries).
+        pub cap_log: usize,
+    }
+
+    /// RISC Zero v3.0.6.
+    pub const STOCK: FriParams = FriParams {
+        queries: super::QUERIES,
+        log_inv_rate: 2,
+        pow_bits: 0,
+        cap_log: 0,
+    };
+
+    static CELLS: [AtomicUsize; 4] = [
+        AtomicUsize::new(STOCK.queries),
+        AtomicUsize::new(STOCK.log_inv_rate),
+        AtomicUsize::new(STOCK.pow_bits),
+        AtomicUsize::new(STOCK.cap_log),
+    ];
+
+    /// The parameters in force.
+    pub fn get() -> FriParams {
+        FriParams {
+            queries: CELLS[0].load(Relaxed),
+            log_inv_rate: CELLS[1].load(Relaxed),
+            pow_bits: CELLS[2].load(Relaxed),
+            cap_log: CELLS[3].load(Relaxed),
+        }
+    }
+
+    /// Put `p` in force; returns the previous parameters.
+    pub fn set(p: FriParams) -> FriParams {
+        assert!(p.log_inv_rate >= 2, "the check polynomial needs INV_RATE >= {}", super::CHECK_PIECES);
+        assert!(p.queries > 0 && p.pow_bits < 32);
+        let prev = get();
+        for (cell, v) in CELLS.iter().zip([p.queries, p.log_inv_rate, p.pow_bits, p.cap_log]) {
+            cell.store(v, Relaxed);
+        }
+        prev
+    }
+
+    /// Restores the previous parameters on drop.
+    pub struct Guard(FriParams);
+
+    impl Drop for Guard {
+        fn drop(&mut self) {
+            set(self.0);
+        }
+    }
+
+    /// Put `p` in force until the guard drops.
+    pub fn scoped(p: FriParams) -> Guard {
+        Guard(set(p))
+    }
+}
+
+pub(crate) fn queries() -> usize {
+    fri_params::get().queries
+}
+
+/// The inverse rate in force (see [fri_params]).
+pub fn inv_rate() -> usize {
+    1 << fri_params::get().log_inv_rate
+}
+
+pub(crate) fn pow_bits() -> usize {
+    fri_params::get().pow_bits
+}
